# Shared by every build and release script.
ADDON="AsgardsGuildFellowship"
# Production manifests, one per supported client. The BigWigs packager tags
# game versions from these suffixes: _Camelot is WoW Forever, _Mainline is Retail.
MANIFESTS=("${ADDON}_Camelot.toc" "${ADDON}_Mainline.toc")
# The BigWigs packager revision builds and releases use, pinned to an exact
# commit (its v2 tag as of 2026-09-28) so an upstream change cannot alter what
# runs. Update deliberately.
PACKAGER_COMMIT="e50a250f8705041e40f2fa1ddcb280a686d65aa0"
